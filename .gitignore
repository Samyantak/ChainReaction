# Python
.venv/
envs/
fixwork/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
pytest-of-*/
cr-debug-*/
cr-fix-*/
pip-build-*/
pip-install-*/
pip-ephem-*/

# Target repos (pre-existing inputs, NOT part of this build)
targets/

# M2 generic path: cached repo checkouts (workspaces/) and before/after
# envs under envs/<workspace-key>/{before,after} (covered by envs/)
workspaces/

# Generated reports
reports/

# Run store: live runs are machine-local; preset recordings are committed
runs/*
!runs/presets/
!runs/presets/**

# LLM prompt-hash cache (regenerable, machine-local)
.llm_cache/

# Frontend (ui/dist is committed so judges don't need Node)
ui/node_modules/
ui/.npm-cache/
!ui/dist/
!ui/dist/**

# Secrets
.env

# Editors
.vscode/
.idea/

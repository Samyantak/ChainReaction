# Environment for live ChainReaction runs. Export these in your shell
# (nothing auto-loads this file):
#   Windows (PowerShell):  $env:MODEL_API_KEY = "<key>"
#   Linux / Mac (bash):    export MODEL_API_KEY="<key>"
#
# Only MODEL_API_KEY is required, and only for live model calls —
# replaying presets needs no key and no network.

MODEL_API_KEY=<key>

# Optional overrides (defaults shown):
# MODEL_API_BASE=https://api.meta.ai/v1
# MODEL_API_MODEL=muse-spark-1.3
# LLM_CACHE_DIR=.llm_cache
# LLM_NO_CACHE=1

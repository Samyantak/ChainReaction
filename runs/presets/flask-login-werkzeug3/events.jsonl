{"data": {"cmd": ["<env-python>", "-c", "import json, os, sys\nfrom coverage import Coverage\ncov = Coverage(data_file=sys.argv[1])\ncov.load()\ndata = cov.get_data()\nfocus = set(json.loads(sys.argv[2])) if len(sys.argv) > 2 else set()\nfiles = {}\nlines = {}\nfor fname in data.measured_files():\n    by_line = data.contexts_by_lineno(fname)\n    tids = set()\n    for names in by_line.values():\n        for raw in names:\n            tid = raw.split('|')[0]\n            if tid:\n                tids.add(tid)\n    if not tids:\n        continue\n    files[fname] = sorted(tids)\n    try:\n        rel = os.path.relpath(fname).replace(os.sep, '/')\n    except ValueError:\n        continue\n    if rel not in focus:\n        continue\n    per_line = {}\n    for lineno, names in by_line.items():\n        ltids = set()\n        for raw in names:\n            tid = raw.split('|')[0]\n            if tid:\n                ltids.add(tid)\n        if ltids:\n            per_line[str(lineno)] = sorted(ltids)\n    if per_line:\n        lines[fname] = per_line\nprint(json.dumps({'files': files, 'lines': lines}))\n", ".coverage-chainreaction", "[\"src/flask_login/utils.py\"]"], "cwd": "<ws>", "env_name": "maxcountryman__flask-login@31e20a3cc143/before", "returncode": 0, "timed_out": false}, "run_id": "0162a9bc33b148eba8ec5699d16d9faa", "seq": 45, "stage": "verify", "ts": "2026-11-04T02:15:57.967Z", "type": "cmd"}
